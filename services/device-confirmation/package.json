{
  "name": "device-confirmation",
  "version": "1.0.0",
  "main": "dist/functionApp.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "watch": "tsc --watch",
    "prestart": "npm run build",
    "start": "func start --typescript",
    "seed:devices": "ts-node tools/seed-device-snapshots.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts' --coveragePathIgnorePatterns='/node_modules/|/__tests__/|/dist/'",
    "test:verbose": "jest --verbose",
    "test:integration": "INTEGRATION_TEST=true jest --testPathPattern=integration.test.ts",
    "test:unit": "jest --testPathIgnorePatterns=integration.test.ts",
    "test:ci": "jest --ci --coverage --maxWorkers=2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@azure/cosmos": "^4.6.0",
    "@azure/eventgrid": "^5.12.0",
    "@azure/functions": "^4.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
